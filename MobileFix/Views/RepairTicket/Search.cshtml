@model IEnumerable<MobileFix.Models.RepairTicket>

<div class="page-header">
    <div>
        <h1>Track / Verify Repair</h1>
        <p>Search using token, IMEI, phone, customer, device or technician</p>
    </div>
</div>

<div class="mf-card">

    <form asp-action="Search" method="get">

        <div class="mf-search-box">

            <input type="text"
                   name="query"
                   value="@ViewBag.Query"
                   placeholder="e.g. MF-2026-0001, IMEI, phone or technician" />

            <button type="submit" class="mf-primary-btn">
                Search
            </button>

        </div>

    </form>

    @if (!Model.Any())
    {
        <div class="mf-empty">
            No repair tickets found.
        </div>
    }
    else
    {
        <div class="mf-table-wrapper">

            <table class="mf-table">

                <thead>
                    <tr>
                        <th>Token</th>
                        <th>Customer</th>
                        <th>Device</th>
                        <th>IMEI</th>
                        <th>Technician</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var ticket in Model)
                    {
                        <tr>

                            <td>
                                <strong>@ticket.Token</strong>
                            </td>

                            <td>
                                @ticket.CustomerName
                            </td>

                            <td>
                                @ticket.Brand @ticket.Model
                            </td>

                            <td>
                                @ticket.IMEI
                            </td>

                            <td>
                                @(ticket.Technician?.Name ?? "Unassigned")
                            </td>

                            <td>
                                <span class="mf-status">
                                    @ticket.Status
                                </span>
                            </td>

                            <td>
                                <a asp-action="Details"
                                   asp-route-id="@ticket.Id"
                                   class="mf-secondary-btn">
                                    Open
                                </a>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>